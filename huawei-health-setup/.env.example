# Huawei Health API Configuration
# Copy this file to .env and fill in your credentials

# Get these from: https://developer.huawei.com/consumer/en/console
HUAWEI_CLIENT_ID=your_client_id_here
HUAWEI_CLIENT_SECRET=your_client_secret_here

# OAuth redirect URI (default for local setup)
HUAWEI_REDIRECT_URI=http://localhost:8080/callback
